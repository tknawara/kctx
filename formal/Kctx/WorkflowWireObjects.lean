/- Factor object normalization from recursive decoding: each field is looked up
   in one normalized red-black tree, without unfolding its value decoder. -/

private theorem objectFold (xs : List (String × Json)) :
    Json.mkObj xs = Json.obj (xs.foldl (fun t kv => t.insert compare kv.1 kv.2) .leaf) := by
  simp [Json.mkObj, List.forIn_pure_yield_eq_foldl, Id.run]

theorem objectGateResult (j0 j1 j2 j3 j4 j5 j6 j7 j8 j9 j10 : Json) :
