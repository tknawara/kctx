  have normalized : object = Json.obj (RBNode.node .black (RBNode.node .black (RBNode.node .red (RBNode.node .black RBNode.leaf "actor" j10 RBNode.leaf) "checker" j2 (RBNode.node .black RBNode.leaf "definition" j0 RBNode.leaf)) "environment" j7 (RBNode.node .black RBNode.leaf "evidence_refs" j9 RBNode.leaf)) "expires_at" j5 (RBNode.node .black (RBNode.node .black RBNode.leaf "observed_at" j4 (RBNode.node .red RBNode.leaf "proposal_revision" j6 RBNode.leaf)) "result" j3 (RBNode.node .black (RBNode.node .red RBNode.leaf "scope" j8 RBNode.leaf) "target_revision" j1 RBNode.leaf))) := by
    simp only [object, objectFold, List.foldl_cons, List.foldl_nil, step0, step1, step2, step3, step4, step5, step6, step7, step8, step9, step10]
  have checkedFields : fields object ["definition", "target_revision", "checker", "result", "observed_at", "expires_at", "proposal_revision", "environment", "scope", "evidence_refs", "actor"] = .ok () := by rw [normalized]; rfl
