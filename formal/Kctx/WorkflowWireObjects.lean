  have read2 : field object "checker" = .ok j2 := by rw [normalized]; rfl
  have read3 : field object "result" = .ok j3 := by rw [normalized]; rfl
  have read4 : field object "observed_at" = .ok j4 := by rw [normalized]; rfl
  have read5 : field object "expires_at" = .ok j5 := by rw [normalized]; rfl
  have read6 : field object "proposal_revision" = .ok j6 := by rw [normalized]; rfl
  have read7 : field object "environment" = .ok j7 := by rw [normalized]; rfl
  have read8 : field object "scope" = .ok j8 := by rw [normalized]; rfl
  have read9 : field object "evidence_refs" = .ok j9 := by rw [normalized]; rfl
