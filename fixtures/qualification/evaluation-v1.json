  "measurement_contract": {
    "mechanical": "Pinned retrieval path parity only; not model quality or actual agent trial. File/existing extracted index/native Dolt use identical graph edges.",
    "agent": "External real model command receives frozen task and pinned source bundle; exact structured labelled answer required. Record model/prompt/tool config and raw output; never infer model execution from mechanical retrieval.",
    "cold": "Fresh worker process and no application cache; OS page cache is not flushed.",
    "warm": "Repeated requests in the same worker; OS page cache is not controlled.",
    "context": "UTF-8 bytes proxy, not tokens.",
    "memory": "Linux ru_maxrss for worker and largest waited child; not simultaneous process-tree RSS.",
    "io": "/proc/self/io read/write counters and resource block operations; no claim of physical device bytes.",
    "setup": "Measured repository creation, initial extraction and graph sync, corpus and database byte counts; excluded from query latency but separately reported."
  }
