# One-command verification stack (compose `verify` service).
# Self-contained: Lean (elan, pinned), pinned python deps for the graph
# package, and the pinned Dolt CLI so the shadow-graph integration tests run
# for real. Nothing on the host but docker.
FROM ubuntu:24.04

ARG DOLT_VERSION=v2.6.1
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      curl ca-certificates git gh python3 python3-pip unzip && \
    rm -rf /var/lib/apt/lists/*

# Lean 4.21.0 via elan (same pin as formal/lean-toolchain; elan's bundled
# clang links the reference evaluator).
ENV ELAN_HOME=/opt/elan
RUN curl -sSfL https://elan.lean-lang.org/elan-init.sh | sh -s -- -y \
      --default-toolchain leanprover/lean4:v4.21.0 --no-modify-path && \
    /opt/elan/bin/lean --version


# Dolt CLI, pinned. Not a database or a backing repo — the tool only; the
# KB's data stays the user's. Integration tests build throwaway databases
# under per-test temp dirs.
RUN curl -sSfL -o /tmp/dolt.tgz \
      "https://github.com/dolthub/dolt/releases/download/${DOLT_VERSION}/dolt-linux-amd64.tar.gz" && \
    tar -xzf /tmp/dolt.tgz -C /tmp && \
    mv /tmp/dolt-linux-amd64/bin/dolt /usr/local/bin/dolt && \
    chmod +x /usr/local/bin/dolt && rm -rf /tmp/dolt.tgz /tmp/dolt-linux-amd64 && \
    dolt version && \
    git config --system user.email kctx-verify@example.invalid && \
    git config --system user.name "kctx verify"

ENV PATH="/opt/elan/bin:${PATH}"
WORKDIR /work/kctx

# Runtime and quality tools are installed from one lock, including Node for
# Pyright. The editable path is the Compose mount path, not a host venv.
RUN pip install --no-cache-dir --break-system-packages "uv==0.9.9"
ENV UV_PROJECT_ENVIRONMENT="/opt/kctx"
ENV PATH="/opt/kctx/bin:${PATH}"
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN uv sync --locked --group dev
